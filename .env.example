# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.

# development | production  (API docs at /docs are disabled in production)
APP_ENV=development

# REQUIRED: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database location (relative paths are resolved from where you run the app)
DATABASE_URL=sqlite:///data/foodrescue.db

# Where uploaded donation photos are stored
UPLOAD_DIR=data/uploads

# JWT lifetime in minutes
TOKEN_EXPIRE_MINUTES=480

# Matching settings
MAX_MATCH_DISTANCE_KM=25
MAX_RECOMMENDATIONS=5
REQUIRE_VOLUNTEER_FEASIBILITY=false

# Expiry warnings and background sweep
EXPIRY_WARNING_HOURS=2
MAINTENANCE_INTERVAL_SECONDS=60

# Password given to the fictional demo accounts created by `python run.py seed`
DEMO_PASSWORD=Demo@12345

# Server
HOST=127.0.0.1
PORT=8000
